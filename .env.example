# Supabase — copy from Supabase Dashboard → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard credentials (owner only)
# Generate ADMIN_PASSWORD_HASH with: node -e "console.log(require('crypto').scryptSync('PASSWORD', require('crypto').randomBytes(16).toString('hex'), 64).toString('hex'))" (prefixed with "SALT:")
ADMIN_EMAIL=admin@gadgeterea.com
ADMIN_PASSWORD_HASH=
ADMIN_COOKIE_SECRET=

# Amazon Creators API — OAuth 2.0 credentials (values stay empty in the repo)
AMAZON_CREATORS_CREDENTIAL_ID=
AMAZON_CREATORS_CREDENTIAL_SECRET=
AMAZON_CREATORS_CREDENTIAL_VERSION=
AMAZON_ASSOCIATE_TAG=
